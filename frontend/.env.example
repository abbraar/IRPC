# Production (e.g. Vercel): public URL of the FastAPI backend, no trailing slash.
# Local dev: leave empty to use the Vite proxy (see vite.config.js).
VITE_API_BASE_URL=

# Optional: show Gemini-related UI affordances when true (backend still controls the API key).
VITE_GEMINI_ENABLED=true

# Local API port for the dev proxy when the backend is on the same machine (default 8000).
VITE_BACKEND_PORT=8000

# Optional: full dev API origin instead of http://127.0.0.1:<VITE_BACKEND_PORT> (e.g. http://192.168.1.10:8080).
# VITE_DEV_API_ORIGIN=
