# Google Generative AI (server-side only; never expose in the frontend).
GEMINI_API_KEY=

# Comma-separated browser origins allowed to call this API (e.g. your Vercel URL).
# Required for cross-origin access when ENVIRONMENT=production.
FRONTEND_ORIGIN=

# Use production to restrict CORS to FRONTEND_ORIGIN only (plus any values listed there).
# Omit or set to development to keep local dev origins allowed alongside FRONTEND_ORIGIN.
ENVIRONMENT=production
