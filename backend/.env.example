# Google Generative AI (server-side only; never expose in the frontend).
GEMINI_API_KEY=

# Model and retry behaviour (optional).
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_MAX_RETRIES=2

# Set to 1, true, or yes to disable Gemini calls (deterministic fallback only).
GEMINI_DISABLED=false

# Future: gemini | openai (openai not implemented in this POC).
NARRATIVE_PROVIDER=gemini

# Comma-separated browser origins allowed to call this API (Unity WebGL, Vercel, etc.).
# ALLOWED_ORIGINS takes precedence over FRONTEND_ORIGIN when both are set.
ALLOWED_ORIGINS=
FRONTEND_ORIGIN=

# Use production to restrict CORS to ALLOWED_ORIGINS / FRONTEND_ORIGIN only.
# Omit or set to development to keep local dev origins allowed alongside configured origins.
ENVIRONMENT=production
